<Window x:Class="PulseWeaver.ProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="取り込むアプリを選択"
        Height="520" Width="580"
        Background="#10141C" Foreground="#F1F5F9"
        WindowStartupLocation="CenterOwner"
        x:ClassModifier="internal">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="取り込むアプリを選択" FontSize="19" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Foreground="#A8B3C5" TextWrapping="Wrap" Margin="0,8,0,14"
                   Text="音を出しているアプリが上に表示されます。アプリの音声だけを取り込み、他のアプリの音とは別のストリップとして扱えます。"/>

        <Border Grid.Row="2" Background="#1B2230" CornerRadius="10" Padding="6">
            <ListBox x:Name="CandidateList" Background="Transparent" BorderThickness="0"
                     Foreground="#F1F5F9" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Detail}" Foreground="#8A97AC" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#1F3A2B" CornerRadius="6" Padding="8,2"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsPlayingAudio, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="再生中" Foreground="#7BE0A3" FontSize="11"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="SelectButton" Content="このアプリを追加" Padding="16,8" Margin="0,0,8,0"
                        Background="#4F7DFF" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                        Cursor="Hand" Click="SelectButton_Click"/>
                <Button Content="キャンセル" Padding="16,8" Background="#30394A" Foreground="#F1F5F9"
                        BorderThickness="0" Cursor="Hand" Click="CancelButton_Click"/>
            </StackPanel>
            <CheckBox x:Name="IncludeTreeCheckBox" Content="子プロセスも含める" IsChecked="True"
                      Foreground="#C6D0DE" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
