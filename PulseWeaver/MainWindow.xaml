<Window x:Class="PulseWeaver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PulseWeaver" Height="640" Width="780"
        MinHeight="580" MinWidth="680"
        Background="#10141C" Foreground="#F1F5F9"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="PulseWeaver" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="音声をまとめて、仮想デバイスへ送るミキサー MVP"
                       Foreground="#A8B3C5" Margin="0,5,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#1B2230" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="入力" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <TextBlock Text="システム音声（選択した再生デバイスをループバック）" Foreground="#C6D0DE"/>
                        <ComboBox x:Name="SystemAudioDeviceCombo" Margin="0,6,0,14" Height="34"
                                  DisplayMemberPath="Name"/>
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Text="システム音量" Width="120" VerticalAlignment="Center"/>
                            <Slider x:Name="SystemVolumeSlider" Minimum="0" Maximum="1" Value="0.8"
                                    TickFrequency="0.05" IsSnapToTickEnabled="False"
                                    ValueChanged="VolumeSlider_ValueChanged"/>
                            <TextBlock x:Name="SystemVolumeLabel" Width="48" Text="80%"
                                       TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </DockPanel>

                        <TextBlock Text="マイク" Foreground="#C6D0DE"/>
                        <ComboBox x:Name="MicrophoneDeviceCombo" Margin="0,6,0,14" Height="34"
                                  DisplayMemberPath="Name"/>
                        <DockPanel>
                            <TextBlock Text="マイク音量" Width="120" VerticalAlignment="Center"/>
                            <Slider x:Name="MicrophoneVolumeSlider" Minimum="0" Maximum="1" Value="0.8"
                                    TickFrequency="0.05" IsSnapToTickEnabled="False"
                                    ValueChanged="VolumeSlider_ValueChanged"/>
                            <TextBlock x:Name="MicrophoneVolumeLabel" Width="48" Text="80%"
                                       TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Background="#1B2230" CornerRadius="10" Padding="18">
                    <StackPanel>
                        <TextBlock Text="ミックス出力" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <TextBlock Text="仮想オーディオデバイス（例：VB-CABLE の再生側）" Foreground="#C6D0DE"/>
                        <ComboBox x:Name="OutputDeviceCombo" Margin="0,6,0,0" Height="34"
                                  DisplayMemberPath="Name"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,18,0,0" LastChildFill="True">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="StartButton" Content="ミックス開始" Click="StartButton_Click"
                        Padding="18,10" Margin="0,0,8,0" Background="#4F7DFF" Foreground="White"
                        BorderThickness="0" FontWeight="SemiBold"/>
                <Button x:Name="StopButton" Content="停止" Click="StopButton_Click"
                        Padding="18,10" Background="#30394A" Foreground="White"
                        BorderThickness="0" IsEnabled="False"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="デバイスを選んで「ミックス開始」を押してください。"
                       Foreground="#A8B3C5" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
