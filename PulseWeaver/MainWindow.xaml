<Window x:Class="PulseWeaver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PulseWeaver" Height="800" Width="980"
        MinHeight="700" MinWidth="880"
        Background="#10141C" Foreground="#F1F5F9"
        Icon="Assets/PulseWeaver.ico"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#A8B3C5"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="8" Padding="18,8" Margin="0,0,6,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1B2230"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#24304A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1B2230"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4F7DFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#30394A"/>
        </Style>

        <Style x:Key="LinkRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#232B3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RouteToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Foreground" Value="#8A97AC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root" Background="#232B3A" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2C374B"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#4F7DFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A8B3C5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SettingsNavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#C6D0DE"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1B2230"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#24304A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NameBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CaretBrush" Value="#4F7DFF"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="5,2" Margin="-5,-2">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#232B3A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#232B3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ChannelRowTemplate">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="168"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="168"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBox Style="{StaticResource NameBox}" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="クリックして名前を変更できます"/>
                    <TextBlock Text="{Binding KindLabel}" Foreground="#7D8AA0" FontSize="11" Margin="0,1,0,0"/>
                </StackPanel>

                <ComboBox Grid.Column="1" ItemsSource="{Binding Options}"
                          SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                          DisplayMemberPath="Name" Height="30" VerticalAlignment="Center"/>

                <Grid Grid.Column="2" Margin="12,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Volume, StringFormat=P0}"
                               TextAlignment="Right" VerticalAlignment="Center"
                               Foreground="#A8B3C5" FontSize="11"/>
                </Grid>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource RouteToggle}" Content="A1"
                                  IsChecked="{Binding RouteA1, Mode=TwoWay}"/>
                    <ToggleButton Style="{StaticResource RouteToggle}" Content="A2"
                                  IsChecked="{Binding RouteA2, Mode=TwoWay}"/>
                    <ToggleButton Style="{StaticResource RouteToggle}" Content="A3"
                                  IsChecked="{Binding RouteA3, Mode=TwoWay}"/>
                    <ToggleButton Style="{StaticResource RouteToggle}" Content="A4"
                                  IsChecked="{Binding RouteA4, Mode=TwoWay}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="OutputRowTemplate">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="168"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="168"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBox Style="{StaticResource NameBox}" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="クリックして名前を変更できます"/>
                    <TextBlock Text="H/W出力" Foreground="#7D8AA0" FontSize="11" Margin="0,1,0,0"/>
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Options}"
                          SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                          DisplayMemberPath="Name" Height="30" VerticalAlignment="Center"/>
                <Grid Grid.Column="2" Margin="12,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Volume, StringFormat=P0}"
                               TextAlignment="Right" VerticalAlignment="Center"
                               Foreground="#A8B3C5" FontSize="11"/>
                </Grid>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <DockPanel>
                <TextBlock x:Name="VersionText" DockPanel.Dock="Right" VerticalAlignment="Bottom"
                           Foreground="#66748C" Margin="0,0,0,4"/>
                <TextBlock Text="PulseWeaver" FontSize="30" FontWeight="Bold"/>
            </DockPanel>
            <TextBlock Text="入力・バーチャル入力を 4 つの出力へ振り分けるミキサー"
                       Foreground="#A8B3C5" Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <RadioButton x:Name="MixerTabButton" Style="{StaticResource TabButton}" Content="ミキサー"
                         GroupName="Tabs" IsChecked="True" Checked="MixerTab_Checked"/>
            <RadioButton x:Name="SettingsTabButton" Style="{StaticResource TabButton}" Content="設定"
                         GroupName="Tabs" Checked="SettingsTab_Checked"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid x:Name="MixerPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="UpdateBanner" Grid.Row="0" Visibility="Collapsed" Background="#1E2A44"
                        CornerRadius="10" Padding="14" Margin="0,0,0,14">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Padding="14,7"
                                Content="設定で確認" VerticalAlignment="Center" Click="OpenUpdateSettings_Click"/>
                        <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Margin="0,0,12,0"/>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="H/W入力（6）" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                                           Text="マイクやライン入力などの録音デバイスを選択します。"/>
                                <ItemsControl x:Name="HardwareInputList" ItemTemplate="{StaticResource ChannelRowTemplate}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="バーチャル入力（3）" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                                           Text="指定した再生デバイスに流れる音をループバックで取り込みます。Discord の出力先を別デバイスにしておくと個別に扱えます。"/>
                                <ItemsControl x:Name="VirtualInputList" ItemTemplate="{StaticResource ChannelRowTemplate}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="H/W出力（4）" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                                           Text="A1〜A4 の出力先を選びます。CABLE Input などを選ぶと Discord からマイクとして扱えます。"/>
                                <ItemsControl x:Name="HardwareOutputList" ItemTemplate="{StaticResource OutputRowTemplate}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <DockPanel Grid.Row="2" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="ミックス開始"
                                Margin="0,0,8,0" Click="StartButton_Click"/>
                        <Button x:Name="StopButton" Style="{StaticResource SecondaryButton}" Content="停止"
                                IsEnabled="False" Click="StopButton_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Text="デバイスを選んで「ミックス開始」を押してください。"
                               Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                </DockPanel>
            </Grid>

            <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ListBox x:Name="SettingsNavList" Grid.Column="0" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource SettingsNavItem}"
                         SelectionChanged="SettingsNavList_SelectionChanged">
                    <ListBoxItem Content="一般"/>
                    <ListBoxItem Content="音声"/>
                    <ListBoxItem Content="構成"/>
                    <ListBoxItem Content="更新情報"/>
                    <ListBoxItem Content="このアプリについて"/>
                </ListBox>

                <ScrollViewer Grid.Column="1" Margin="18,0,0,0" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <StackPanel x:Name="GeneralSettingsPanel">
                            <TextBlock Text="一般" Style="{StaticResource SectionTitle}"/>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <CheckBox x:Name="AutoCheckCheckBox" Content="起動時にアップデートを自動確認する（24時間に1回）"
                                              Foreground="#F1F5F9" Checked="GeneralOption_Changed"
                                              Unchecked="GeneralOption_Changed"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                               Text="オフにすると、自動では確認せず「更新情報」から手動で確認します。"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox x:Name="AutoStartCheckBox" Content="Windows 起動時に PulseWeaver を自動起動する"
                                              Foreground="#F1F5F9" Checked="GeneralOption_Changed"
                                              Unchecked="GeneralOption_Changed"/>
                                    <CheckBox x:Name="BackgroundStartCheckBox" Content="バックグラウンドで起動する（タスクトレイに常駐）"
                                              Foreground="#F1F5F9" Margin="0,10,0,0" Checked="GeneralOption_Changed"
                                              Unchecked="GeneralOption_Changed"/>
                                    <CheckBox x:Name="AutoStartMixCheckBox" Content="起動時にミックスを自動開始する"
                                              Foreground="#F1F5F9" Margin="0,10,0,0" Checked="GeneralOption_Changed"
                                              Unchecked="GeneralOption_Changed"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                               Text="バックグラウンド起動を有効にすると、閉じるボタンでタスクトレイに格納され、ミックスは動き続けます。自動起動と併用するとタスクトレイで静かに起動します。"/>

                                    <TextBlock Text="起動時に適用する既定の構成" Foreground="#C6D0DE" Margin="0,16,0,0"/>
                                    <ComboBox x:Name="DefaultProfileCombo" Margin="0,6,0,0" Height="34" Width="320"
                                              HorizontalAlignment="Left" DisplayMemberPath="Name"
                                              SelectionChanged="DefaultProfileCombo_SelectionChanged"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                               Text="「（現在の設定）」を選ぶと、前回終了時の構成で起動します。"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="AudioSettingsPanel" Visibility="Collapsed">
                            <TextBlock Text="音声" Style="{StaticResource SectionTitle}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="出力バッファ（レイテンシ）" Foreground="#C6D0DE"/>
                                    <ComboBox x:Name="LatencyCombo" Margin="0,6,0,0" Height="34" Width="220"
                                              HorizontalAlignment="Left" SelectionChanged="LatencyCombo_SelectionChanged">
                                        <ComboBoxItem Content="50 ms（低遅延）" Tag="50"/>
                                        <ComboBoxItem Content="100 ms（標準）" Tag="100"/>
                                        <ComboBoxItem Content="200 ms（安定重視）" Tag="200"/>
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                               Text="小さいほど遅延は減りますが、音切れが起きやすくなります。次回ミックス開始時に反映されます。"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                               Text="音量と A1〜A4 の振り分けは動作中でも即時反映されます。デバイスの変更は「停止」してから再度「ミックス開始」してください。"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="ProfileSettingsPanel" Visibility="Collapsed">
                            <TextBlock Text="構成" Style="{StaticResource SectionTitle}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="保存済みの構成" Foreground="#C6D0DE"/>
                                    <ComboBox x:Name="ProfileCombo" Margin="0,6,0,0" Height="34" Width="320"
                                              HorizontalAlignment="Left" DisplayMemberPath="Name"
                                              SelectionChanged="ProfileCombo_SelectionChanged"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                               Text="選択すると即座に構成が切り替わります（ミックス中なら再起動します）。"/>

                                    <TextBlock Text="現在の構成を保存" Foreground="#C6D0DE" Margin="0,16,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBox x:Name="ProfileNameBox" Width="240" Height="32"
                                                 VerticalContentAlignment="Center" Padding="8,0"
                                                 Background="#111722" Foreground="#F1F5F9"
                                                 BorderBrush="#2C374B" CaretBrush="#4F7DFF"
                                                 ToolTip="例: ゲーム配信、Discord通話"/>
                                        <Button x:Name="SaveProfileButton" Style="{StaticResource PrimaryButton}"
                                                Content="保存" Margin="8,0,0,0" Padding="16,7"
                                                Click="SaveProfileButton_Click"/>
                                        <Button x:Name="OverwriteProfileButton" Style="{StaticResource SecondaryButton}"
                                                Content="選択中に上書き" Margin="8,0,0,0" Padding="16,7"
                                                IsEnabled="False" Click="OverwriteProfileButton_Click"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Style="{StaticResource SecondaryButton}" Content="エクスポート"
                                                Margin="0,0,8,0" Click="ExportSettingsButton_Click"/>
                                        <Button Style="{StaticResource SecondaryButton}" Content="インポート"
                                                Margin="0,0,8,0" Click="ImportSettingsButton_Click"/>
                                        <Button Style="{StaticResource SecondaryButton}" Content="再読み込み"
                                                Margin="0,0,8,0" Click="ReloadProfilesButton_Click"/>
                                        <Button Style="{StaticResource SecondaryButton}" Content="フォルダを開く"
                                                Click="OpenProfilesFolder_Click"/>
                                    </StackPanel>

                                    <TextBlock x:Name="ProfileStatusText" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                               Text="構成ファイルはアプリの usr/settings フォルダに JSON で保存されます。手動で置いたファイルも一覧に表示されます。"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="UpdateSettingsPanel" Visibility="Collapsed">
                            <TextBlock Text="更新情報" Style="{StaticResource SectionTitle}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="現在のバージョン" Foreground="#A8B3C5" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CurrentVersionText" Grid.Column="1" Text="v0.0.0"
                                                   FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <Button x:Name="CheckUpdatesButton" Style="{StaticResource SecondaryButton}"
                                            Content="最新かどうかを調べる" HorizontalAlignment="Left"
                                            Click="CheckUpdatesButton_Click"/>

                                    <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Caption}" Margin="0,12,0,0"
                                               Text="まだ確認していません。"/>

                                    <ProgressBar x:Name="UpdateProgressBar" Visibility="Collapsed" Height="6"
                                                 Minimum="0" Maximum="100" Margin="0,10,0,0"
                                                 Foreground="#4F7DFF" Background="#2A3345" BorderThickness="0"/>

                                    <StackPanel x:Name="UpdateActionsPanel" Orientation="Horizontal"
                                                Visibility="Collapsed" Margin="0,14,0,0">
                                        <Button x:Name="InstallUpdateButton" Style="{StaticResource PrimaryButton}"
                                                Content="アップデートする" Margin="0,0,8,0"
                                                Click="InstallUpdateButton_Click"/>
                                        <Button x:Name="OpenReleasePageButton" Style="{StaticResource SecondaryButton}"
                                                Content="リリースページを開く" Click="OpenReleasePageButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="過去のリリース" Style="{StaticResource SectionTitle}" Margin="0,18,0,8"/>
                            <Border Style="{StaticResource Card}" Padding="8">
                                <StackPanel>
                                    <ItemsControl x:Name="ReleaseHistoryList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,4">
                                                    <Button Style="{StaticResource LinkRowButton}" Tag="{Binding HtmlUrl}"
                                                            Click="ReleaseHistoryItem_Click">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="170"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Note}"
                                                                       Foreground="#8A97AC" TextTrimming="CharacterEllipsis"
                                                                       Margin="8,0,8,0"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding PublishedText}"
                                                                       Foreground="#8A97AC" FontSize="12"/>
                                                        </Grid>
                                                    </Button>
                                                    <ItemsControl ItemsSource="{Binding Changes}" Margin="16,0,10,4">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" Foreground="#9AA7BC" FontSize="11"
                                                                           TextWrapping="Wrap" Margin="0,1,0,1"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="ReleaseHistoryEmptyText" Style="{StaticResource Caption}"
                                               Margin="10,6,10,6" Visibility="Collapsed"
                                               Text="履歴はまだありません。「最新かどうかを調べる」で取得します。"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="AboutSettingsPanel" Visibility="Collapsed">
                            <TextBlock Text="このアプリについて" Style="{StaticResource SectionTitle}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="AboutVersionText" Text="PulseWeaver" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                               Text="H/W入力とバーチャル入力をミックスし、4つの H/W 出力へ振り分ける Windows 向けミキサーです。"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                               Text="音声処理に NAudio（MIT License）を使用しています。仮想オーディオドライバーは同梱していません。"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Style="{StaticResource SecondaryButton}" Content="リポジトリを開く"
                                                Margin="0,0,8,0" Click="OpenRepository_Click"/>
                                        <Button Style="{StaticResource SecondaryButton}" Content="VB-CABLE の配布ページ"
                                                Margin="0,0,8,0" Click="OpenVirtualCable_Click"/>
                                        <Button Style="{StaticResource SecondaryButton}" Content="ログフォルダを開く"
                                                Click="OpenLogFolder_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
